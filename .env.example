# Copy this file to .env and adjust values as needed.
# Environment configuration for uaa-agent.

# Model used by the root Agent (see agent.py)
MODEL=gemini-2.5-flash

# Logging level when running agent.py as a script
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive)
LOG_LEVEL=INFO

# Default repository URL for example clone helper
UAA_REPO_URL=https://github.com/cloudfoundry/uaa

# Base seconds for exponential backoff between clone retries in clone_repository.
# Lower this (e.g., 0.05 or 0.01) to speed up test cycles; increase for production stability.
UAA_CLONE_BASE_BACKOFF=1.0

# Base URL of the UAA server (used by UAAServerInformationClient)
# Change if your UAA runs on a different host/port or behind a path prefix.
UAA_BASE_URL=http://localhost:8080/uaa

# Java version to use when building the UAA server
# Change if your UAA server to be build with a different Java version
UAA_JAVA_VERSION="21.0.9-amzn"
