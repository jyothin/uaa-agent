# Copy this file to .env and adjust values as needed.
# Environment configuration for uaa-agent.

# Model used by the root Agent (see agent.py)
UAA_MODEL=gemini-2.5-flash

# Default repository URL for example clone helper
UAA_REPO_URL=https://github.com/cloudfoundry/uaa

# Logging level when running agent.py as a script
LOG_LEVEL=INFO
